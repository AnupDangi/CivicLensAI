# All values are server-only. Do not add NEXT_PUBLIC_ to credentials.
# Use a pooled runtime URL and a direct migration URL in serverless deployments.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
HOST_TOKEN_SECRET=replace-with-at-least-32-random-characters
FIXTURE_MODE=true

# Async jobs (set the webhook URL to your Trigger.dev task endpoint)
TRIGGER_SECRET_KEY=
TRIGGER_WEBHOOK_URL=

# Models and retrieval
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=google/gemini-3.7-flash
OPENROUTER_DEEP_MODEL=google/gemini-3.1-pro-preview
TAVILY_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=

# Social source access and social evidence
XPOZ_API_KEY=
MANAGED_EXTRACTOR_URL=
MANAGED_EXTRACTOR_API_KEY=

# Temporary uploads
BLOB_READ_WRITE_TOKEN=

# Civic Rooms
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Set this in both the web deployment and the LiveKit worker deployment.
LIVEKIT_TRANSCRIBER_NAME=civiclens-transcriber
# LiveKit Inference defaults to multilingual Deepgram Nova-3. Override only if needed.
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=en

# Optional observability
SENTRY_DSN=
